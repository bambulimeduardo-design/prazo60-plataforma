# Copie para ".env" apenas em desenvolvimento local. NUNCA versione o .env.
# Em producao (Render), configure estas variaveis no painel Environment.

PRAZO60_AMBIENTE=desenvolvimento
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
APP_USER=DATAHOLICS
# Opcional: hash gerado por scripts/gerar_hash_senha.py (sem ele, vale o hash padrao)
APP_PASSWORD_HASH=
SESSION_MAX_HOURS=8
COOKIE_SECURE=false

# Power BI (link de incorporacao do Power BI Service)
POWERBI_EMBED_URL=
POWERBI_TITULO=Relatorio Prazo60

# Oracle Autonomous Database / Select AI
SELECT_AI_HABILITADO=false
SELECT_AI_PERFIL=PRAZO60_AI
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=prazo60db_medium
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=
